import pandas as pd
import numpy as np
import re

# 1. Load cleaned data from Notebook 1
df = pd.read_csv('C:\Users\alagu\OneDrive\Documents\Desktop\git repo\Student_Budget_Analytics\Data\01_cleaned_data.csv')

# Helper function to convert expense ranges to numeric midpoints
def convert_range_to_midpoint(val):
    if pd.isna(val):
        return np.nan
    val_str = str(val).replace('₹', '').strip()
    
    if '<' in val_str:
        num = re.findall(r'\d+', val_str)
        return float(num[0]) / 2.0 if num else 250.0
    elif '>' in val_str:
        num = re.findall(r'\d+', val_str)
        return float(num[0]) + 500.0 if num else 5500.0
    elif '-' in val_str:
        nums = re.findall(r'\d+', val_str)
        if len(nums) >= 2:
            return (float(nums[0]) + float(nums[1])) / 2.0
            
    return 1000.0  # Fallback median

# 2. Apply range conversion to all Expense & Allowance columns
expense_cols = [
    'Food Expenses  (Monthly)', 
    'Transport Expenses  (Monthly)', 
    'Academic Expenses  (Monthly)', 
    'Other Expenses (Monthly)',
    'Monthly Allowance'
]

for col in expense_cols:
    clean_name = col.split('(')[0].replace('Expenses', '').strip() + '_Est'
    df[clean_name] = df[col].apply(convert_range_to_midpoint)

# 3. Create Engineered Spend Ratio Features
df['Total_Estimated_Expenses'] = (
    df['Food_Est'] + df['Transport_Est'] + df['Academic_Est'] + df['Other_Est']
)
df['Spend_to_Allowance_Ratio'] = df['Total_Estimated_Expenses'] / (df['Monthly_Est'] + 1e-5)

# 4. Prepare Feature Matrix
drop_cols = [
    'S.No', 'Student Name', 'Do you maintain a monthly budget plan?', 
    'Maintain_Budget_Target'
] + expense_cols

X = df.drop(columns=drop_cols)
y = df['Maintain_Budget_Target']

# One-hot encode categorical features
X_encoded = pd.get_dummies(X, drop_first=True)
X_encoded['Maintain_Budget_Target'] = y

# 5. Export features
output_path = '../data/processed/02_features_data.csv'
X_encoded.to_csv(output_path, index=False)

print("Notebook 2 completed successfully!")
print(f"Features matrix saved with shape: {X_encoded.shape}")